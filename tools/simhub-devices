def limpar_ngen():
    """Move as imagens nativas de SimHub.Plug* para fora (reversivel)."""
    imgs = ngen_ativo()
    if not imgs:
        print(f"  {OK} sem cache NGen de SimHub.Plugins")
        return
    guardado = os.path.join(PFX, "ngen-backup")
    for nome in imgs:
        passo(f"mover {nome} -> {guardado}/")
        if APLICAR:
            import shutil
            os.makedirs(guardado, exist_ok=True)
            destino = os.path.join(guardado, nome)
            if os.path.exists(destino):
                shutil.rmtree(destino)
            shutil.move(os.path.join(NGEN, nome), destino)


