CHAVE_WINEBUS = "HKLM\\System\\CurrentControlSet\\Services\\winebus"


def ler_enable_hidraw():
    """Entradas VVVV:PPPP ja presentes no EnableHidraw do prefixo.

    Formato de `wine reg query`:  EnableHidraw   REG_MULTI_SZ   a:b\\0c:d\\0..."""
    try:
        r = subprocess.run(["wine", "reg", "query", CHAVE_WINEBUS, "/v", "EnableHidraw"],
                           env=dict(os.environ, WINEPREFIX=PFX, WINEDEBUG="-all"),
                           capture_output=True, text=True, timeout=60)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None                      # nao da' para saber; None != "esta vazio"
    if r.returncode != 0:
        return []                        # chave/valor ainda nao existe
    for linha in r.stdout.splitlines():
        if "REG_MULTI_SZ" not in linha:
            continue
        valor = linha.split("REG_MULTI_SZ", 1)[1].strip().replace("\r", "")
        return [e for e in valor.split("\\0") if e]
    return []


def instalar_registro():
    """winebus: EnableHidraw + a rede de seguranca (Enable SDL=0 e DisableInput=1).

    ⚠️ A chave e' Services\\winebus, NAO a subchave \\Parameters — o driver nunca
    le' \\Parameters. Esse erro custou tres dias no projeto Conspit.

    ⚠️ O valor e' COMPARTILHADO do prefixo, nao nosso. O projeto irmao
    conspit-linux-configurator grava `3514:*` aqui para os pedais CPP.LITE, e
    escrever a lista do CATALOGO por cima apagava aquilo em silencio -- o pedal
    sumia da aba Devices e o sintoma aparecia longe da causa. Agora a lista final
    e' a UNIAO do que ja' existe com o que este projeto precisa."""
    print("\n== registro do prefixo (winebus) ==\n")
    exigir_simhub_parado("install registry")
    nosso = {f"{v}:{p}" for (v, p), (_, rec, _) in CATALOGO.items() if rec == "hid"}
    existente = ler_enable_hidraw()
    if existente is None:
        print(f"  {AVISO} nao consegui ler o EnableHidraw atual (wine indisponivel?).")
        print(f"  {AVISO} vou gravar so' as entradas deste projeto — se voce tinha")
        print(f"  {AVISO} outras (ex.: Conspit 3514:*), anote-as antes de continuar.")
        existente = []
    alheias = sorted(set(existente) - nosso)
    hid = sorted(nosso | set(existente))
    reg = ("Windows Registry Editor Version 5.00\n\n"
           "[HKEY_LOCAL_MACHINE\\System\\CurrentControlSet\\Services\\winebus]\n"
           f'"EnableHidraw"={multi_sz(hid)}\n'
           '"Enable SDL"=dword:00000000\n'
           '"DisableInput"=dword:00000001\n')
    print(f"  {INFO} EnableHidraw com {len(hid)} entradas ({hid[0]} ... {hid[-1]})")
    if alheias:
        print(f"  {INFO} preservadas {len(alheias)} entrada(s) de fora do catalogo: "
              f"{', '.join(alheias)}")
    backup(os.path.join(PFX, "system.reg"), "bak-simhub-devices")
    importar_reg(reg, "Services\\winebus")
    print(f"\n  {INFO} rode 'wineserver -k' para o winebus reler.\n")


