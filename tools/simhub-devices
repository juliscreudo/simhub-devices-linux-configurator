def simhub_rodando():
    # ⚠️ `pgrep -f` casa a linha de comando inteira, entao um `wine taskkill /im
    #    SimHubWPF.exe` em curso dispara falso positivo. Filtramos esses.
    try:
        out = subprocess.run(["pgrep", "-af", "SimHub[W]PF\\.exe"],
                             capture_output=True, text=True)
    except FileNotFoundError:
        return False
    for linha in out.stdout.splitlines():
        if "taskkill" in linha or "pgrep" in linha:
            continue
        return True
    return False


def exigir_simhub_parado(acao):
    """⚠️ O SimHub sobrescreve settings ao sair e segura a DLL. Mexer com ele de
    pe' desfaz o trabalho em silencio — foi como perdemos instancias de device."""
    if simhub_rodando():
        sys.exit(f"{ERRO} o SimHub esta rodando. Feche-o antes de '{acao}'.\n"
                 f"   (ele sobrescreve settings ao sair e mantem a DLL aberta)")


def backup(caminho, sufixo):
    """Copia com sufixo, sem sobrescrever backup anterior. Devolve o caminho."""
    if not os.path.exists(caminho):
        return None
    alvo = f"{caminho}.{sufixo}"
    if os.path.exists(alvo):
        return alvo
    passo(f"backup: {alvo}")
    if APLICAR:
        shutil.copy2(caminho, alvo)
    return alvo


def mascarar_serial(texto):
    r"""Troca o numero de serie USB por <SERIAL> na saida de tela.

    ⚠️ O caminho PnP da receita 2 termina no serial do device
    (`Enum\USB\VID_xxxx&PID_xxxx\<serial>`), e a saida de dry-run e' justamente
    o que se cola num issue para pedir ajuda. Serial nao e' metadado: fabricante
    usa serial como prova de titularidade em garantia. O registro recebe o valor
    real; quem e' mascarado e' o ECO na tela."""
    return re.sub(r"(PID_[0-9A-Fa-f]{4}\\)([^\\\]\s\"]{4,})", r"\1<SERIAL>", texto)


def importar_reg(conteudo, rotulo):
    """Escreve um .reg e importa com regedit /S. Devolve True se aplicou.

    ⚠️ `reg add` NAO escreve REG_MULTI_SZ nem hex(ffff0012); .reg + regedit e' o
    unico caminho que funciona (custou uma rodada de diagnostico na receita 2)."""
    import tempfile
    passo(f"importar registro: {rotulo}")
    if not APLICAR:
        for l in conteudo.strip().split("\n")[:6]:
            print(f"           | {mascarar_serial(l)}")
        return False
    tmp = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".reg", delete=False,
                                         encoding="utf-16") as f:
            f.write(conteudo)
            tmp = f.name
        env = dict(os.environ, WINEPREFIX=PFX, WINEDEBUG="-all")
        r = subprocess.run(["wine", "regedit", "/S", tmp], env=env,
                           capture_output=True, text=True)
        # ⚠️ o returncode era descartado: um regedit que falha (prefixo travado,
        #    wineserver caindo) imprimia "aplicando" e nao gravava nada. Falha
        #    silenciosa e' exatamente o que este script existe para nao repetir.
        if r.returncode != 0:
            sys.exit(f"{ERRO} regedit falhou (codigo {r.returncode}) em '{rotulo}'\n"
                     f"   {(r.stderr or r.stdout).strip()[-400:]}")
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)
    return True


def multi_sz(linhas):
    """REG_MULTI_SZ em .reg: hex(7) com UTF-16LE, cada string NUL-terminada."""
    dados = b""
    for l in linhas:
        dados += l.encode("utf-16-le") + b"\x00\x00"
    dados += b"\x00\x00"
    return "hex(7):" + ",".join(f"{b:02x}" for b in dados)


def devprop_string(texto):
    r"""⚠️ DEVPKEY_* no Wine: tipo hex(ffff0012), UTF-16LE + 00 00.

    Sem isso o SetupDiGetDevicePropertyW devolve erro 1168, o SimHub cai no
    fallback do nome e a regex `\((COM\d+)\)` nao acha porta nenhuma."""
    dados = texto.encode("utf-16-le") + b"\x00\x00"
    return "hex(ffff0012):" + ",".join(f"{b:02x}" for b in dados)


