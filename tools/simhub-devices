def ler(caminho):
    """Conteudo de um arquivo de texto, ou None se nao der para ler."""
    try:
        with open(caminho, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def usb_presentes():
    achados = []
    for d in sorted(glob.glob("/sys/bus/usb/devices/*")):
        vid = ler(os.path.join(d, "idVendor"))
        pid = ler(os.path.join(d, "idProduct"))
        if vid is None or pid is None:
            continue
        achados.append((vid.strip(), pid.strip(), os.path.basename(d)))
    return achados


def hidraw_de(vid, pid):
    """No hidraw do device + se o usuario tem acesso de leitura/escrita."""
    for h in glob.glob("/sys/class/hidraw/hidraw*"):
        txt = ler(os.path.join(h, "device/uevent"))
        if txt is None:
            continue
        m = re.search(r"HID_ID=\w+:0000([0-9A-Fa-f]{4}):0000([0-9A-Fa-f]{4})", txt)
        if m and m.group(1).lower() == vid and m.group(2).lower() == pid:
            no = "/dev/" + os.path.basename(h)
            return no, os.access(no, os.R_OK | os.W_OK)
    return None, False


def no_usb_acessivel(porta):
    busnum = ler(f"/sys/bus/usb/devices/{porta}/busnum")
    devnum = ler(f"/sys/bus/usb/devices/{porta}/devnum")
    if busnum is None or devnum is None:
        return None, False
    no = f"/dev/bus/usb/{int(busnum):03d}/{int(devnum):03d}"
    return no, os.access(no, os.R_OK | os.W_OK)


def ngen_ativo():
    """Imagens nativas de SimHub.Plugins presentes (lista, vazia = nenhuma).

    Elas IGNORAM patches de IL.

    O SimHub roda 32-bit e executa a imagem pre-compilada; qualquer patch em
    SimHub.Plugins.dll vira no-op ate essa pasta ser removida. Sondas x64 JIT-am
    o IL do disco e enganam quem estiver medindo.
    """
    ni = os.path.join(PFX, "drive_c/windows/assembly/NativeImages_v4.0.30319_32")
    if not os.path.isdir(ni):
        return []
    return [d for d in os.listdir(ni) if d.startswith("SimHub.Plug")]


