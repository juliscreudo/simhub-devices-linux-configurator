def rodar(cmd, oque):
    """subprocess com erro legivel. ⚠️ check=True cru vira traceback de
    CalledProcessError, que esconde o que falhou de quem so' quer instalar."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        sys.exit(f"{ERRO} nao encontrei '{cmd[0]}' no PATH ({oque}).")
    if r.returncode != 0:
        sys.exit(f"{ERRO} falhou ao {oque}: {' '.join(cmd)}\n"
                 f"   {(r.stderr or r.stdout).strip()[-400:]}")
    return r


