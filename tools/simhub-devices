def doctor():
    print("\n== devices da bancada ==\n")
    vistos = 0
    for vid, pid, porta in usb_presentes():
        chave = (vid, pid)
        if chave not in CATALOGO:
            continue
        vistos += 1
        nome, receita, obs = CATALOGO[chave]
        print(f"  {vid}:{pid}  {nome}")
        print(f"       porta USB {porta}")

        if receita == "hid":
            no, pode = hidraw_de(vid, pid)
            if no is None:
                print(f"    {ERRO} sem no hidraw — o kernel nao expos o device como HID")
            elif pode:
                print(f"    {OK} {no} acessivel (regra udev ativa)")
            else:
                print(f"    {ERRO} {no} sem permissao — falta a regra udev (TAG+=\"uaccess\")")
        elif receita == "usb":
            no, pode = no_usb_acessivel(porta)
            if no is None:
                # ⚠️ distinguir dos casos de permissao: aqui o no nem existe.
                print(f"    {ERRO} no USB nao encontrado em /sys — o device sumiu do barramento?")
            else:
                print(f"    {OK if pode else ERRO} {no} "
                      f"{'acessivel' if pode else 'sem permissao (falta udev)'}")
            no_ar = helper_da_ponte_no_ar()      # uma consulta so', nao duas
            print(f"    {OK if no_ar else ERRO} helper da ponte (porta {PONTE_PORTA}) "
                  f"{'no ar' if no_ar else 'FORA — a tela nao vai conectar'}")
        elif receita == "serial":
            print(f"    {INFO} receita serial: confira o no PnP e o DEVPKEY_NAME no prefixo")

        if chave not in TESTADOS:
            print(f"    {AVISO} nao validado com hardware neste projeto")
        if obs:
            print(f"    {INFO} {obs}")
        print()

    if not vistos:
        print("  nenhum device conhecido plugado.\n")

    checar_camadas()

    print("\n== prefixo do SimHub ==\n")
    print(f"  {OK if os.path.isdir(SH_DIR) else ERRO} SimHub em {SH_DIR}")

    # ⚠️ imagem nativa engole patch de IL: o app roda 32-bit e ignora a DLL
    ng = ngen_ativo()
    if ng:
        print(f"  {AVISO} cache NGen ATIVO ({len(ng)} imagem(ns) de SimHub.Plug*)")
        print(f"  {AVISO} qualquer patch em SimHub.Plugins.dll e' IGNORADO pelo app.")
        print(f"  {AVISO} remova: NativeImages_v4.0.30319_32/SimHub.Plug*")
    else:
        print(f"  {OK} sem cache NGen de SimHub.Plugins (patches de IL valem)")
    # ⚠️ a distincao que da' nome ao script: enabled != tentado != funcionando
    print(f"\n  {INFO} lembrete: 'Searching device...' na UI significa que o SimHub esta")
    print(f"  {INFO} TENTANDO. Se o device nem aparece no log em DEBUG, ele nem foi")
    print(f"  {INFO} escaneado — problema diferente, a montante do driver.\n")



