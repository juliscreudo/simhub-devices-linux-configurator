def instalar_udev():
    print("\n== regras udev ==\n")
    origem = os.path.join(REPO, "udev")
    regras = sorted(glob.glob(os.path.join(origem, "*.rules")))
    if not regras:
        sys.exit(f"{ERRO} nenhuma regra em {origem}")
    destino = "/etc/udev/rules.d"
    for r in regras:
        alvo = os.path.join(destino, os.path.basename(r))
        igual = os.path.exists(alvo) and open(alvo).read() == open(r).read()
        if igual:
            print(f"  {OK} {os.path.basename(r)} ja instalada e identica")
            continue
        passo(f"sudo install -m644 {r} {alvo}")
        if APLICAR:
            subprocess.run(["sudo", "install", "-m", "644", r, alvo], check=True)
    passo("sudo udevadm control --reload && sudo udevadm trigger")
    if APLICAR:
        subprocess.run(["sudo", "udevadm", "control", "--reload"], check=True)
        subprocess.run(["sudo", "udevadm", "trigger"], check=True)
    print(f"\n  {INFO} replugue o device (ou reinicie) se a ACL nao aparecer.\n")


def instalar_registro():
    """winebus: EnableHidraw + a rede de seguranca (Enable SDL=0 e DisableInput=1).

    ⚠️ A chave e' Services\\winebus, NAO a subchave \\Parameters — o driver nunca
    le' \\Parameters. Esse erro custou tres dias no projeto Conspit."""
    print("\n== registro do prefixo (winebus) ==\n")
    exigir_simhub_parado("install registry")
    hid = sorted({f"{v}:{p}" for (v, p), (_, rec, _) in CATALOGO.items() if rec == "hid"})
    reg = ("Windows Registry Editor Version 5.00\n\n"
           "[HKEY_LOCAL_MACHINE\\System\\CurrentControlSet\\Services\\winebus]\n"
           f'"EnableHidraw"={multi_sz(hid)}\n'
           '"Enable SDL"=dword:00000000\n'
           '"DisableInput"=dword:00000001\n')
    print(f"  {INFO} EnableHidraw com {len(hid)} entradas ({hid[0]} ... {hid[-1]})")
    backup(os.path.join(PFX, "system.reg"), "bak-simhub-devices")
    importar_reg(reg, "Services\\winebus")
    print(f"\n  {INFO} rode 'wineserver -k' para o winebus reler.\n")


def instalar_ponte():
    print("\n== ponte libusb (telas VoCore) ==\n")
    exigir_simhub_parado("install bridge")
    dll_origem = os.path.join(PONTE, "libusb-1.0.dll")
    if not os.path.exists(dll_origem):
        sys.exit(f"{ERRO} nao achei {dll_origem}\n"
                 f"   clone e compile ~/apps/wine-libusb-bridge primeiro")
    dll_alvo = os.path.join(SH_DIR, "libusb-1.0.dll")
    orig = dll_alvo + ".orig"
    if os.path.exists(dll_alvo) and not os.path.exists(orig):
        passo(f"preservar a original: {orig}")
        if APLICAR:
            import shutil
            shutil.copy2(dll_alvo, orig)
    passo(f"instalar DLL da ponte em {dll_alvo}")
    if APLICAR:
        import shutil
        shutil.copy2(dll_origem, dll_alvo)

    # ⚠️ o helper precisa estar de pe' ANTES do SimHub, senao a DLL devolve erro.
    #    Resolvido por LAUNCHER, nao por systemd user unit: o helper so' existe
    #    para servir o SimHub, entao amarrar o tempo de vida dele ao do app evita
    #    socket pendurado e o LIBUSB_ERROR_BUSY da proxima abertura.
    lanc = os.path.join(REPO, "tools", "run-simhub")
    if not os.path.exists(lanc):
        print(f"  {AVISO} {lanc} nao encontrado")
    else:
        destino = os.path.expanduser("~/.local/bin/run-simhub")
        passo(f"link {destino} -> {lanc}")
        if APLICAR:
            os.makedirs(os.path.dirname(destino), exist_ok=True)
            if os.path.islink(destino) or os.path.exists(destino):
                os.unlink(destino)
            os.symlink(lanc, destino)
    print(f"\n  {INFO} abra o SimHub com 'run-simhub' — ele sobe a ponte antes e a")
    print(f"  {INFO} derruba depois. ⚠️ nunca com 'wine SimHubWPF.exe' direto: sem o")
    print(f"  {INFO} lsu-launch-wrapper a telemetria nao chega.\n")


