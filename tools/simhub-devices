def simhub_rodando():
    # ⚠️ `pgrep -f` casa a linha de comando inteira, entao um `wine taskkill /im
    #    SimHubWPF.exe` em curso dispara falso positivo. Filtramos esses.
    try:
        out = subprocess.run(["pgrep", "-af", "SimHub[W]PF\\.exe"],
                             capture_output=True, text=True)
    except FileNotFoundError:
        return False
    for linha in out.stdout.splitlines():
        if "taskkill" in linha or "pgrep" in linha:
            continue
        return True
    return False


