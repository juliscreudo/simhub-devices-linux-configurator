    print(f"  {INFO} sem os passos abaixo, a tela, a PDU5 e o atalho voltam a falhar\n"
          f"  {INFO} sem avisar.\n")
    exigir_simhub_parado("post-update")
    instalar_ponte()
    instalar_pdu5_leds()
    instalar_atalho()


def main():
    global APLICAR
    ap = argparse.ArgumentParser(prog="simhub-devices", add_help=True,
                                 description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--apply", action="store_true",
                    help="executa de fato (sem isso, so' mostra o que faria)")
    # ⚠️ --apply aceito em qualquer posicao: `install bridge --apply` e' o que a
    #    mao digita naturalmente, e errar isso vira "por que nao fez nada?"
    #
    # ⚠️ default=SUPPRESS e' o que faz funcionar NO MEIO (`install --apply bridge`).
    #    argparse copia o namespace do subparser por cima do namespace do pai, e
    #    sem SUPPRESS o parser de terceiro nivel reaplicava apply2=False e apagava
    #    o valor -- o comando virava dry-run em silencio, com o usuario achando que
    #    tinha pedido para aplicar. Medido nas tres posicoes; ver testes no README.
    comum = argparse.ArgumentParser(add_help=False)
    comum.add_argument("--apply", action="store_true", dest="apply2",
                       default=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("doctor", parents=[comum])
    ins = sub.add_parser("install", parents=[comum]).add_subparsers(dest="alvo")
    for nome_ in ("udev", "registry", "bridge", "pdu5-leds", "shortcut"):
        ins.add_parser(nome_, parents=[comum])
    ser = ins.add_parser("serial", parents=[comum])
    ser.add_argument("--dev"); ser.add_argument("--vid", default="3514")
    ser.add_argument("--pid", default="0007"); ser.add_argument("--com", type=int, default=37)
    ser.add_argument("--serial"); ser.add_argument("--nome", default="SERIAL DEVICE")
    sub.add_parser("post-update", parents=[comum])
    sub.add_parser("clean-cache", parents=[comum])

    a = ap.parse_args()
    APLICAR = a.apply or getattr(a, "apply2", False)
    if not a.cmd or a.cmd == "doctor":
        doctor(); return
    if a.cmd == "post-update":
        pos_update()
    elif a.cmd == "clean-cache":
        limpar_cache()
    elif a.cmd == "install":
        acoes = {"udev": instalar_udev, "registry": instalar_registro,
                 "bridge": instalar_ponte, "pdu5-leds": instalar_pdu5_leds,
                 "shortcut": instalar_atalho}
        if a.alvo in acoes:
            acoes[a.alvo]()
        elif a.alvo == "serial":
            instalar_serial(a)
        else:
            sys.exit("install: use udev | registry | bridge | pdu5-leds | serial | shortcut")
    if not APLICAR:
        print(f"  {AVISO} DRY-RUN — nada foi alterado. Repita com --apply.\n")


if __name__ == "__main__":
    main()
