def ponte_dir():
    """Onde a ponte esta, em ordem de precedencia.

    1. SIMHUB_PONTE — override explicito
    2. vendor/ — o que o instalador baixou
    3. ~/apps/wine-libusb-bridge — copia de desenvolvimento (o caso do autor
       enquanto o repo da ponte nao tem remote)
    """
    env = os.environ.get("SIMHUB_PONTE")
    if env:
        return os.path.expanduser(env)
    if os.path.isdir(VENDOR):
        return VENDOR
    return os.path.expanduser("~/apps/wine-libusb-bridge")


def ponte_versao(ponte):
    """Rotulo de versao da ponte REALMENTE em uso.

    ⚠️ .ponte-version descreve o que o instalador baixou para vendor/. Ler o
    arquivo sem olhar de onde a ponte veio fazia o doctor anunciar a tag de um
    vendor/ que nem estava em uso, enquanto rodava a copia de desenvolvimento."""
    if os.path.abspath(ponte) != os.path.abspath(VENDOR):
        return "copia local"
    txt = ler(ARQ_VERSAO)
    return txt.strip() if txt else "vendor/ sem .ponte-version"


def ponte_baixar():
    """Busca a release fixada do GitHub para vendor/. Devolve True se trouxe algo.

    ⚠️ Enquanto o repo da ponte nao for publicado isto nao tem o que buscar, e o
    fallback e' a copia local de desenvolvimento.

    ⚠️ O que vem daqui e' COMPILADO e instalado no prefixo. Por isso o repo de
    origem so' pode ser trocado com consentimento explicito: SIMHUB_PONTE_REPO
    apontando para outro lugar significaria `make` em codigo de terceiro. Para
    desenvolver contra um fork, use SIMHUB_PONTE (diretorio local, sem download)
    ou passe SIMHUB_PONTE_REPO_OK=1 assumindo o risco."""
    if not PONTE_REPO:
        print(f"  {INFO} a ponte ainda nao tem repo publicado; usando copia local")
        return False
    if PONTE_REPO != PONTE_REPO_PADRAO and os.environ.get("SIMHUB_PONTE_REPO_OK") != "1":
        print(f"  {AVISO} SIMHUB_PONTE_REPO aponta para '{PONTE_REPO}', que nao e' o repo")
        print(f"  {AVISO} padrao ({PONTE_REPO_PADRAO}). O tarball seria compilado e")
        print(f"  {AVISO} instalado no prefixo. Confirme com SIMHUB_PONTE_REPO_OK=1,")
        print(f"  {AVISO} ou use SIMHUB_PONTE=<diretorio> para apontar uma copia local.")
        return False
    import io
    import json
    import tarfile
    import urllib.error
    import urllib.request
    api = f"https://api.github.com/repos/{PONTE_REPO}/releases/"
    api += f"tags/{PONTE_VERSAO}" if PONTE_VERSAO else "latest"
    passo(f"buscar release da ponte: {api}")
    if not APLICAR:
        return False
    rede = (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, OSError)
    try:
        with urllib.request.urlopen(api, timeout=15) as r:
            rel = json.load(r)
        tag = rel.get("tag_name", "?")
        fonte = rel.get("tarball_url")
        if not fonte:
            print(f"  {AVISO} release {tag} sem tarball — usando copia local")
            return False
        # ⚠️ o download do tarball estava FORA do try: uma queda de rede aqui
        #    derrubava o comando com traceback em vez do fallback documentado.
        with urllib.request.urlopen(fonte, timeout=60) as r:
            dados = r.read()
    except rede as e:
        print(f"  {AVISO} nao consegui buscar a release ({e}) — usando copia local")
        return False
    except (ValueError, KeyError) as e:
        print(f"  {AVISO} resposta inesperada da API ({e}) — usando copia local")
        return False

    os.makedirs(os.path.dirname(VENDOR), exist_ok=True)
    if os.path.isdir(VENDOR):
        shutil.rmtree(VENDOR)
    try:
        with tarfile.open(fileobj=io.BytesIO(dados), mode="r:gz") as t:
            nomes = t.getnames()
            if not nomes:
                print(f"  {AVISO} tarball vazio — usando copia local")
                return False
            raiz = nomes[0].split("/")[0]
            t.extractall(os.path.dirname(VENDOR), filter="data")
        extraido = os.path.join(os.path.dirname(VENDOR), raiz)
        if os.path.isdir(VENDOR):
            shutil.rmtree(VENDOR)
        os.rename(extraido, VENDOR)
    except (tarfile.TarError, OSError) as e:
        print(f"  {AVISO} nao consegui extrair a release ({e}) — usando copia local")
        return False
    with open(ARQ_VERSAO, "w", encoding="utf-8") as f:
        f.write(tag + "\n")
    print(f"  {OK} ponte {tag} em vendor/  (sha256 do tarball: {_sha256(dados)[:16]}…)")
    return True
