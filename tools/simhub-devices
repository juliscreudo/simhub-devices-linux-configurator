    pe' desfaz o trabalho em silencio — foi como perdemos instancias de device."""
    if simhub_rodando():
        sys.exit(f"{ERRO} o SimHub esta rodando. Feche-o antes de '{acao}'.\n"
                 f"   (ele sobrescreve settings ao sair e mantem a DLL aberta)")


def backup(caminho, sufixo):
    """Copia com sufixo, sem sobrescrever backup anterior. Devolve o caminho."""
    if not os.path.exists(caminho):
        return None
    alvo = f"{caminho}.{sufixo}"
    if os.path.exists(alvo):
        return alvo
    passo(f"backup: {alvo}")
    if APLICAR:
        import shutil
        shutil.copy2(caminho, alvo)
    return alvo


def importar_reg(conteudo, rotulo):
    """Escreve um .reg e importa com regedit /S.

    ⚠️ `reg add` NAO escreve REG_MULTI_SZ nem hex(ffff0012); .reg + regedit e' o
    unico caminho que funciona (custou uma rodada de diagnostico na receita 2)."""
    import tempfile
    passo(f"importar registro: {rotulo}")
    if not APLICAR:
        for l in conteudo.strip().split("\n")[:6]:
            print(f"           | {l}")
        return
    with tempfile.NamedTemporaryFile("w", suffix=".reg", delete=False,
                                     encoding="utf-16") as f:
        f.write(conteudo)
        tmp = f.name
    env = dict(os.environ, WINEPREFIX=PFX, WINEDEBUG="-all")
    subprocess.run(["wine", "regedit", "/S", tmp], env=env,
                   capture_output=True, text=True)
    os.unlink(tmp)


def multi_sz(linhas):
    """REG_MULTI_SZ em .reg: hex(7) com UTF-16LE, cada string NUL-terminada."""
    dados = b""
    for l in linhas:
        dados += l.encode("utf-16-le") + b"\x00\x00"
    dados += b"\x00\x00"
    return "hex(7):" + ",".join(f"{b:02x}" for b in dados)


def devprop_string(texto):
    r"""⚠️ DEVPKEY_* no Wine: tipo hex(ffff0012), UTF-16LE + 00 00.

    Sem isso o SetupDiGetDevicePropertyW devolve erro 1168, o SimHub cai no
    fallback do nome e a regex `\((COM\d+)\)` nao acha porta nenhuma."""
    dados = texto.encode("utf-16-le") + b"\x00\x00"
    return "hex(ffff0012):" + ",".join(f"{b:02x}" for b in dados)


