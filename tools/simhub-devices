def seriais_disponiveis():
    return sorted(glob.glob("/dev/serial/by-id/*"))


def instalar_serial(args):
    """Receita 2: no PnP com DEVPKEY_NAME + porta COM + symlink.

    ⚠️ Todos os volantes Conspit do catalogo do SimHub passam por aqui (medido em
    2026-08-19: os 7 usam StandardProtocolManager). Nao e' um caso do H.AO."""
    print("\n== receita 2: device serial -> porta COM ==\n")
    if not args.dev:
        print("  devices seriais disponiveis:\n")
        for s_ in seriais_disponiveis():
            print(f"    {s_}")
        print(f"\n  {INFO} escolha um e rode:")
        print(f"  {INFO}   simhub-devices install serial --dev <caminho> \\")
        print(f"  {INFO}       --vid 3514 --pid 0007 --com 37 --nome 'CONSPIT H.AO' --apply\n")
        return
    exigir_simhub_parado("install serial")
    if args.com <= 32:
        sys.exit(f"{ERRO} use COM > 32. O wineboot preenche com1..com32 varrendo\n"
                 f"   /dev/ttyS* e sobrescreve qualquer symlink nessa faixa.")

    serial_usb = args.serial or os.path.basename(args.dev).split("_")[-1].split("-")[0]
    rotulo = f"{args.nome} (COM{args.com})"
    vid, pid = args.vid.upper(), args.pid.upper()
    base = ("HKEY_LOCAL_MACHINE\\System\\CurrentControlSet\\Enum\\USB"
            f"\\VID_{vid}&PID_{pid}\\{serial_usb}")
    NOME = "{b725f130-47ef-101a-a5f1-02608c9eebac}"      # DEVPKEY_NAME
    FRIENDLY = "{a45c254e-df1c-4efd-8020-67d146a850e0}"  # DEVPKEY_Device_FriendlyName

    linhas = [
        "Windows Registry Editor Version 5.00", "",
        f"[{base}]",
        '"Class"="Ports"',
        '"ClassGUID"="{4d36e978-e325-11ce-bfc1-08002be10318}"',
        f'"FriendlyName"="{rotulo}"',
        '"Service"="Serial"',
        '"ConfigFlags"=dword:00000000',
        f'"HardwareId"="USB\\VID_{vid}&PID_{pid}"', "",
        f"[{base}\\Device Parameters]",
        f'"PortName"="COM{args.com}"', "",
        # ⚠️ e' ESTA subchave que o SimHub le'; sem ela o nome cai no fallback
        f"[{base}\\Properties\\{NOME}\\000A]",
        f'@={devprop_string(rotulo)}', "",
        f"[{base}\\Properties\\{FRIENDLY}\\000E]",
        f'@={devprop_string(rotulo)}', "",
        "[HKEY_LOCAL_MACHINE\\Software\\Wine\\Ports]",
        f'"COM{args.com}"="{args.dev}"', "",
    ]
    backup(os.path.join(PFX, "system.reg"), "bak-serial")
    importar_reg("\n".join(linhas), f"COM{args.com} -> {args.nome}")

    link = os.path.join(PFX, "dosdevices", f"com{args.com}")
    passo(f"symlink {link} -> {args.dev}")
    if APLICAR:
        if os.path.islink(link) or os.path.exists(link):
            os.unlink(link)
        os.symlink(args.dev, link)
    print(f"\n  {INFO} rode 'wineserver -k': o SERIALCOMM e' volatil e so' e'")
    print(f"  {INFO} repovoado quando o wineserver reinicia.\n")


def pos_update():
